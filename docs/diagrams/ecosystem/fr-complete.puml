@startuml fr-complete
!pragma layout smetana
skinparam backgroundColor #15191D
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam defaultFontColor #EDF2EE
skinparam shadowing false
skinparam roundcorner 10
skinparam componentStyle uml2
skinparam ArrowColor #96A79F
skinparam ArrowFontColor #D0DDD5
skinparam ArrowFontSize 13
skinparam packageStyle rectangle
skinparam packageBackgroundColor #1E2528
skinparam packageBorderColor #52655D
skinparam packageFontColor #F1F5F2
skinparam packageFontSize 19
skinparam componentBackgroundColor #273035
skinparam componentBorderColor #6A7F73
skinparam componentFontColor #EDF2EE
skinparam nodesep 30
skinparam ranksep 35
hide stereotype

title Écosystème complet
package "FlacCompagnon" {
component "flaccompagnon\nApp desktop" as FApp
component "flaccompagnon-cli\nAnalyse en ligne de commande" as FCli
component "flaccompagnon-services\nTags / conversion / organisation" as FServices
component "flaccompagnon-core\nAnalyse / intégrité / rapports" as FCore #3B4930
component "flaccompagnon-spectrogram\nSpectrogrammes / PNG sans perte" as FSpectrogram #3B4930
}
package "Aède" {
component "aede-desktop\nConsole desktop du serveur" as AApp
component "aede-desktop-core\nConfiguration / cycle de vie" as AConsole
component "aede-cli\nCommandes / processus serveur" as ACli
component "aede-server\nAPI HTTP / WebSocket" as AServer
component "aede-devices\nLecteurs audio réseau" as ADevices
component "aede-core\nCatalogue / crédits / persistance" as ACore
component "aede-accounts\nIdentités / rôles / accès" as AAccounts
component "aede-moods\nAmbiances / descripteurs audio" as AMoods
component "aede-audio\nDécodage / files PCM / sortie minimale" as AAudio #3B4930
component "aede-dsp\nTraitement du signal audio" as ADsp #3B4930
}
package "Phémios" {
component "phemios\nApp desktop musicale" as PApp
component "phemios-core\nOrchestration native de la lecture" as PCore
component "phemios-cd\nCD audio / images CUE" as PCd
component "phemios-transfer\nTransferts vers les périphériques" as PTransfer
}
FApp --> FServices
FApp --> FCore
FCli --> FCore
FServices --> FCore
FCore --> FSpectrogram
FApp -[#D8F36A]-> AAudio : output
FCore -[#D8F36A]-> AAudio : decode
AApp --> AConsole
ACli --> AServer
ACli --> ACore
ACli --> ADevices
ACli --> ADsp
ACli --> AAudio : queue
ACli -[#D8F36A]-> FCore
AServer --> ACore
AServer --> ADevices
AServer --> AMoods
AServer --> ADsp
ADevices --> ACore
ACore --> AAccounts
ACore --> AMoods
ACore --> ADsp
ACore --> AAudio : decode + dsp
ACore -[#D8F36A]-> FCore
AAudio --> ADsp
PApp --> PCore
PApp --> PCd
PApp --> PTransfer
PCore --> PCd
PCore -[#D8F36A]-> AAudio : queue
AConsole -[#71CDE1,dashed]right-> ACli : lance un processus
PCore -[#71CDE1,dashed]-> AServer : HTTPS / WSS
PApp -[#71CDE1,dashed]-> AServer : via le pont natif
legend bottom
Flèche pleine : utilise la bibliothèque cible.
Pointillés bleus : connexion ou processus à l’exécution.
endlegend
@enduml
