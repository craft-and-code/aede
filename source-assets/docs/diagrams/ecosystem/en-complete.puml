@startuml en-complete
!pragma layout smetana
skinparam backgroundColor #15191D
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam defaultFontColor #EDF2EE
skinparam shadowing false
skinparam roundcorner 10
skinparam componentStyle uml2
skinparam ArrowColor #96A79F
skinparam ArrowFontColor #D0DDD5
skinparam ArrowFontSize 13
skinparam packageStyle rectangle
skinparam packageBackgroundColor #1E2528
skinparam packageBorderColor #52655D
skinparam packageFontColor #F1F5F2
skinparam packageFontSize 19
skinparam componentBackgroundColor #273035
skinparam componentBorderColor #6A7F73
skinparam componentFontColor #EDF2EE
skinparam nodesep 30
skinparam ranksep 35
hide stereotype

title Complete ecosystem
package "FlacCompagnon" {
component "flaccompagnon\nDesktop App" as FApp
component "flaccompagnon-cli\nCommand-line analysis" as FCli
component "flaccompagnon-services\nTags / conversion / organization" as FServices
component "flaccompagnon-core\nAnalysis / integrity / reports" as FCore #3B4930
}
package "Aède" {
component "aede-desktop\nServer desktop console" as AApp
component "aede-desktop-core\nConfiguration / process lifecycle" as AConsole
component "aede-cli\nCommands / server process" as ACli
component "aede-server\nHTTP API / WebSocket" as AServer
component "aede-devices\nNetwork audio devices" as ADevices
component "aede-core\nCatalogue / credits / persistence" as ACore
component "aede-accounts\nIdentities / roles / credentials" as AAccounts
component "aede-moods\nMoods / audio descriptors" as AMoods
component "aede-audio\nDecode / PCM queues / minimal output" as AAudio #3B4930
component "aede-dsp\nAudio signal processing" as ADsp #3B4930
}
package "Phémios" {
component "phemios\nMusic desktop App" as PApp
component "phemios-core\nNative playback orchestration" as PCore
component "phemios-cd\nAudio CDs / CUE images" as PCd
component "phemios-transfer\nPortable-device transfers" as PTransfer
}
FApp --> FServices
FApp --> FCore
FCli --> FCore
FServices --> FCore
FApp -[#D8F36A]-> AAudio : output
FCore -[#D8F36A]-> AAudio : decode
AApp --> AConsole
ACli --> AServer
ACli --> ACore
ACli --> ADevices
ACli --> ADsp
ACli --> AAudio : queue
ACli -[#D8F36A]-> FCore
AServer --> ACore
AServer --> ADevices
AServer --> AMoods
AServer --> ADsp
ADevices --> ACore
ACore --> AAccounts
ACore --> AMoods
ACore --> ADsp
ACore --> AAudio : decode + dsp
ACore -[#D8F36A]-> FCore
AAudio --> ADsp
PApp --> PCore
PApp --> PCd
PApp --> PTransfer
PCore --> PCd
PCore -[#D8F36A]-> AAudio : queue
AConsole -[#71CDE1,dashed]right-> ACli : starts a process
PCore -[#71CDE1,dashed]-> AServer : HTTPS / WSS
PApp -[#71CDE1,dashed]-> AServer : via native bridge
legend bottom
Solid arrow: uses the target library.
Blue dashed arrow: runtime connection or process.
endlegend
@enduml
