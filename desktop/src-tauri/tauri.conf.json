{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aède",
  "version": "0.7.0",
  "identifier": "fr.craftandcode.aede",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/prepare-engine.mjs && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aède — serveur",
        "width": 1020,
        "height": 780,
        "minWidth": 760,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "externalBin": ["binaries/aede-engine"],
    "category": "Music",
    "shortDescription": "Local-first music library server",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
